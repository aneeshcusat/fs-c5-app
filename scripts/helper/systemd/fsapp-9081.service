[Unit]
Description=Famstack Spring Boot App (9081)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/famstack-app/fsapp
EnvironmentFile=/home/famstack-app/common/env/fsapp_9081.env
ExecStart=/home/famstack-app/common/bin/run_java_app.sh /home/famstack-app/common/env/fsapp_9081.env
SuccessExitStatus=143
Restart=always
RestartSec=10
StandardOutput=append:/tmp/f9081_3.0.13_2_1.log
StandardError=append:/tmp/f9081_3.0.13_2_1.log
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
